// store MTP state
mtp_state := PhaseState.aborting;
// call general pre-state-machine logic
pre_state_machine();
// initialize stepnumber if first scan in this state
IF mtp_state_has_changed THEN
	stepnumber:= {{ phase_type.first_aborting_step }};
END_IF
// call the S88 state machine
s88_state_machine();
// call general post-state-machine-logic
post_state_machine();
// jump to aborted
MTP_Aborting := (state = PhaseState.aborted);
            </xhtml>
          </ST>
        </body>
      </Method>
