            </variable>
            <variable name="TestOutput1 ">
                <type><DINT /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> TestOutput1 comment</xhtml></documentation>
            </variable>




        </outputVars>

        <localVars>


            <variable name="command_start ">
                <type><BOOL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Start command</xhtml></documentation>
            </variable>
            <variable name="command_reset ">
                <type><BOOL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Reset command</xhtml></documentation>
            </variable>
            <variable name="command_resume ">
                <type><BOOL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Resume command</xhtml></documentation>
            </variable>
