                <type><BOOL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Abort command</xhtml></documentation>
            </variable>
            <variable name="command_unhold ">
                <type><BOOL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Unhold command</xhtml></documentation>
            </variable>
            <variable name="TestInternal1 ">
                <type><DINT /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> TestInternal1 comment</xhtml></documentation>
            </variable>
            <variable name="TargetLevel ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Calculated before dosing</xhtml></documentation>
            </variable>
            <variable name="StartLevel ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Stored before dosing</xhtml></documentation>
            </variable>
            <variable name="a ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> </xhtml></documentation>
            </variable>
            <variable name="b ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> </xhtml></documentation>
            </variable>
            <variable name="c ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> </xhtml></documentation>
            </variable>
            <variable name="d ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> </xhtml></documentation>
            </variable>


        </localVars>

        <tempVars>

        </tempVars>
    </interface>
