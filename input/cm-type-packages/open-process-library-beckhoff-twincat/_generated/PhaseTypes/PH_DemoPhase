    <addData>
        <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="s88_state_machine">
                <interface><returnType><BOOL /></returnType></interface>
                <body>
                <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">
                        <![CDATA[
start_conditions:= true;


CASE stepnumber OF
    // Idle - Step 0
    0:
        //================================
        
        //--------------------------------
        // # Idle
        //================================
        stepinfo:= TO_STRING("S0$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 0 to 10
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T10: command_start && start_conditions$L"));
        
        IF (
            command_start AND start_conditions
        ) THEN
            stepnumber := 10;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 10
    10:
        //================================
        
        //--------------------------------
        // # Variables can be assigned new values through mathematical formula's
        // // simple calculation
        // TargetLevel = StartLevel + DosingQuantity - DosingOffset
        // // use of brackets
        // a = b * (c + d)
        //================================
        stepinfo:= TO_STRING("S10$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action
        TargetLevel := StartLevel + DosingQuantity - DosingOffset;
        a := b * (c + d);

        // Transition 10 to 20
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T20: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 20;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 10 to 30
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T30: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 30;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 10 to 20
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T20: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 20;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 10 to 20
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T20: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 20;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 10 to 20
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T20: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 20;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 10 to 20
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T20: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 20;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 20
    20:
        //================================
        
        //--------------------------------
        // # Control Modules can be controlled like this:
        // # [verb] [ControlModuleName]
        // # The verbs are configured in the CM Type Package.
        // # ControlModuleName can be an abstract name, because one PhaseType can have multiple Phase Instances with diffent Control Module Instancees connected
        // // open a valve
        // open DosingValve
        // // close a valve
        // close DosingValve
        //================================
        stepinfo:= TO_STRING("S20$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action
        DosingValve.open := true;
        DosingValve.open := false;

        // Transition 20 to 30
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T30: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 30;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 20 to 30
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T30: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 30;
            state := PhaseState.Starting; // Starting
        END_IF;

        // Transition 20 to 30
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T30: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 30;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 30
    30:
        //================================
        
        //--------------------------------
        // # // Variables on Control Modules can be accessed directly
        // # (tip: the preference goes to configuring and using verbs and states if this makes things more readable for non-automation engineers)
        // DosingValve.reset = true
        //================================
        stepinfo:= TO_STRING("S30$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action
        DosingValve.reset := true;

        // Transition 30 to 1000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T1000: DosingValve.automaticMode = true$L"));
        
        IF (
            DosingValve.automaticMode = true
        ) THEN
            stepnumber := 1000;
            state := PhaseState.Execute; // Execute
        END_IF;


    // Starting - Step 40
    40:
        //================================
        
        //--------------------------------
        // # todo: AnalogMeasurement examples
        //================================
        stepinfo:= TO_STRING("S40$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 40 to 50
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T50: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 50;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 50
    50:
        //================================
        
        //--------------------------------
        // # todo: AnalogValve examples
        //================================
        stepinfo:= TO_STRING("S50$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 50 to 60
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T60: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 60;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 60
    60:
        //================================
        
        //--------------------------------
        // # todo: DigitalMeasurement examples
        //================================
        stepinfo:= TO_STRING("S60$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 60 to 70
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T70: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 70;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 70
    70:
        //================================
        
        //--------------------------------
        // # todo: PIDController examples
        //================================
        stepinfo:= TO_STRING("S70$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 70 to 80
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T80: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 80;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 80
    80:
        //================================
        
        //--------------------------------
        // # todo: ReversingMotor examples
        //================================
        stepinfo:= TO_STRING("S80$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 80 to 90
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T90: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 90;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 90
    90:
        //================================
        
        //--------------------------------
        // # todo: VFD examples
        //================================
        stepinfo:= TO_STRING("S90$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 90 to 100
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T100: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 100;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 100
    100:
        //================================
        
        //--------------------------------
        // # Actions can be conditionally executed:
        // # [action] if [condition]
        // open DosingValve if a > 100
        //================================
        stepinfo:= TO_STRING("S100$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action
        IF (a > 100) THEN
            DosingValve.open := true;
        END_IF;

        // Transition 100 to 110
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T110: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 110;
            state := PhaseState.Starting; // Starting
        END_IF;


    // Starting - Step 110
    110:
        //================================
        
        //--------------------------------
        // # Conditional actions can also have a delay: the condition needs to be active for a delaytime before the action is  executed
        // # [action] if [condition] for [delay][timeUnit]
        // # [timeUnit] options: ms, s, min, h, days
        // # If delay is a variable then [timeUnit] is not needed (it will be deducted from the unit configured at the variable)
        // # tip: hover over the action line to see the DelayMultiplier to calculate milliseconds, as well as the timer number that will be used when generating the code
        // open DosingValve if a > 100 for 5s
        //================================
        stepinfo:= TO_STRING("S110$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action
        StepTimer_2.PT := T#1ms * REAL_TO_DINT(5 * 1000);
        StepTimer_2.IN := NOT #PL_Global.ST.NewStep AND a > 100;
        StepTimer_2();
        IF (StepTimer_2.Q) THEN
            DosingValve.open := true;
        END_IF;

        // Transition 110 to 1000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T1000: false$L"));
        
        IF (
            false
        ) THEN
            stepnumber := 1000;
            state := PhaseState.Execute; // Execute
        END_IF;


    // Execute - Step 1000
    1000:
        //================================
        
        //--------------------------------
        // # Execute
        //================================
        stepinfo:= TO_STRING("S1000$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 1000 to 2000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T2000: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 2000;
            state := PhaseState.Completing; // Completing
        END_IF;


    // Pausing - Step 4000
    4000:
        //================================
        
        //--------------------------------
        // # Pausing
        //================================
        stepinfo:= TO_STRING("S4000$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 4000 to 4500
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T4500: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 4500;
            state := PhaseState.Paused; // Paused
        END_IF;


    // Paused - Step 4500
    4500:
        //================================
        
        //--------------------------------
        // # Paused
        //================================
        stepinfo:= TO_STRING("S4500$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 4500 to 4600
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T4600: command_resume && start_conditions$L"));
        
        IF (
            command_resume AND start_conditions
        ) THEN
            stepnumber := 4600;
            state := PhaseState.Resuming; // Resuming
        END_IF;


    // Resuming - Step 4600
    4600:
        //================================
        
        //--------------------------------
        // # Resuming
        //================================
        stepinfo:= TO_STRING("S4600$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 4600 to 1000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T1000: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 1000;
            state := PhaseState.Execute; // Execute
        END_IF;


    // Completing - Step 2000
    2000:
        //================================
        
        //--------------------------------
        // # Completing
        //================================
        stepinfo:= TO_STRING("S2000$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 2000 to 2100
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T2100: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 2100;
            state := PhaseState.Completed; // Completed
        END_IF;


    // Completed - Step 2100
    2100:
        //================================
        
        //--------------------------------
        // # Completed
        //================================
        stepinfo:= TO_STRING("S2100$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 2100 to 3000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T3000: command_reset$L"));
        
        IF (
            command_reset
        ) THEN
            stepnumber := 3000;
            state := PhaseState.Resetting; // Resetting
        END_IF;


    // Holding - Step 5000
    5000:
        //================================
        
        //--------------------------------
        // # Holding
        //================================
        stepinfo:= TO_STRING("S5000$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 5000 to 5500
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T5500: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 5500;
            state := PhaseState.Held; // Held
        END_IF;


    // Held - Step 5500
    5500:
        //================================
        
        //--------------------------------
        // # Held
        //================================
        stepinfo:= TO_STRING("S5500$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 5500 to 5600
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T5600: command_unhold && start_conditions$L"));
        
        IF (
            command_unhold AND start_conditions
        ) THEN
            stepnumber := 5600;
            state := PhaseState.Unholding; // Unholding
        END_IF;


    // Unholding - Step 5600
    5600:
        //================================
        
        //--------------------------------
        // # Unholding
        //================================
        stepinfo:= TO_STRING("S5600$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 5600 to 1000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T1000: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 1000;
            state := PhaseState.Execute; // Execute
        END_IF;


    // Stopping - Step 6000
    6000:
        //================================
        
        //--------------------------------
        // # Stopping
        //================================
        stepinfo:= TO_STRING("S6000$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 6000 to 6500
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T6500: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 6500;
            state := PhaseState.Stopped; // Stopped
        END_IF;


    // Stopped - Step 6500
    6500:
        //================================
        
        //--------------------------------
        // # Stopped
        //================================
        stepinfo:= TO_STRING("S6500$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 6500 to 3000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T3000: command_reset$L"));
        
        IF (
            command_reset
        ) THEN
            stepnumber := 3000;
            state := PhaseState.Resetting; // Resetting
        END_IF;


    // Aborting - Step 7000
    7000:
        //================================
        
        //--------------------------------
        // # Aborting
        //================================
        stepinfo:= TO_STRING("S7000$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 7000 to 7500
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T7500: true$L"));
        
        IF (
            true
        ) THEN
            stepnumber := 7500;
            state := PhaseState.Aborted; // Aborted
        END_IF;


    // Aborted - Step 7500
    7500:
        //================================
        
        //--------------------------------
        // # Aborted
        //================================
        stepinfo:= TO_STRING("S7500$L");
        stepinfo := CONCAT(stepinfo, TO_STRING("$L"));

        // Action

        // Transition 7500 to 3000
        stepinfo := CONCAT(stepinfo, TO_STRING("---$L"));
        stepinfo := CONCAT(stepinfo, TO_STRING("T3000: command_reset$L"));
        
        IF (
            command_reset
        ) THEN
            stepnumber := 3000;
            state := PhaseState.Resetting; // Resetting
        END_IF;


    // Resetting - Step 3000
    3000:
        //================================
        
        //--------------------------------
        // # Resetting
        //================================
