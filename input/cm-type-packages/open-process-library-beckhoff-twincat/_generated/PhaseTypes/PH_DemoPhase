            </variable>
            <variable name="CurrentTime ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Current time (now), updated each controller cycle</xhtml></documentation>
            </variable>
            <variable name="start_conditions ">
                <type><BOOL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> True if all start conditions are ok. For usage in the ′Idle′ transition</xhtml></documentation>
            </variable>
            <variable name="StepTime ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> StepTime in s</xhtml></documentation>
            </variable>
            <variable name="StepTimeSetpoint ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Steptime Setpoint in s. Will automatically count down in StepTimeRemaining</xhtml></documentation>
            </variable>
            <variable name="StepTimeWatchdog ">
                <type><REAL /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> for monitoring if StepTime passes this watchdog</xhtml></documentation>
