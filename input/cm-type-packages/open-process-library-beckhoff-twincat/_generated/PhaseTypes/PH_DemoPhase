            </variable>


            <variable name="PhaseId ">
                <type><DINT /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Unqiue ID of the Phase Instance in the entire project. Can be used to acquire EM′s</xhtml></documentation>
            </variable>
            <variable name="UnitId ">
                <type><DINT /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> Unqiue ID of the Unit Instance that this Phase Instance belongs to.</xhtml></documentation>
            </variable>
            <variable name="TestInput1 ">
                <type><DINT /></type>
                <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml"> TestInput1 comment</xhtml></documentation>
            </variable>


