<pou name="PH_DemoPhase" pouType="functionBlock">
    <documentation>
        Phase Type
    </documentation>
    <interface>
        <addData>
            <data name="http://www.3s-software.com/plcopenxml/pouinheritance" handleUnknown="implementation">
